# Puerto del servidor de la API
PORT=3000

# Conexión a MySQL local
DB_HOST=localhost
DB_PORT=3306
DB_USER=ducky_app
DB_PASSWORD=DuckyApp2026!
DB_NAME=biblioteca_ducky

# Clave para firmar los tokens de sesión (cámbiala por una cadena larga y aleatoria)
JWT_SECRET=cambia-esta-clave-por-una-larga-y-secreta
JWT_EXPIRES_IN=8h

# Orígenes permitidos, separados por comas: web (5173), app móvil en navegador (8100) y app Android (http://localhost)
CORS_ORIGIN=http://localhost:5173,http://localhost:8100,http://localhost
