# URL de la API. En el navegador (ionic serve / npm run dev) se deja vacía: Vite reenvía /api al puerto 3000.
# Para el APK de Android pon la IP de tu PC en la red local, por ejemplo:
#   VITE_API_URL=http://192.168.1.50:3000/api
# (El emulador de Android usa http://10.0.2.2:3000/api, que ya es el valor por defecto en el teléfono.)
VITE_API_URL=
